# OpenAI API (required if not using OpenRouter)
OPENAI_API_KEY=your-openai-api-key

# OpenRouter (alternative provider)
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override base URL if needed (default set automatically for OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# LangSmith for observability (recommended)
# Get your key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=content-review-squad
